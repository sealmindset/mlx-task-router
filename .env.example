# =============================================================================
# MLX Task Router Configuration
# =============================================================================
# Copy this file to ~/.config/mlx-task-router/.env (recommended for global use)
# or to .env in the project directory (for development).
#
# Environment variables always take precedence over .env files.
# =============================================================================

# --- Required ---
# Your Anthropic API key. Used to forward complex requests to the real API.
# Get one at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# HuggingFace token for authenticated model downloads (faster, higher rate limits).
# Get one at: https://huggingface.co/settings/tokens
# HF_TOKEN=hf_...

# --- Server ---
HOST=0.0.0.0
PORT=8888

# --- Model ---
# MLX model to load at startup (any HuggingFace path from mlx-community)
#
# Qwen3.6-27B-OptiQ: Best local coding model for Apple Silicon (April 2026)
#   - Dense 27B with mixed-precision quantization (~18GB)
#   - SWE-bench Verified: 77.2% | Terminal-Bench 2.0: 59.3% (= Claude 4.5 Opus)
#   - 128K native context, Thinking Preservation across turns
#   - Runs comfortably on 32GB+ machines (M2 Pro and up)
#   - Compatible with stock mlx-lm (no mlx-vlm needed)
#
# Alternatives:
#   mlx-community/Qwen3-Coder-Next-4bit              — MoE 80B/3B active, 70.6% SWE-bench, ~48GB (128GB required)
#   mlx-community/Qwen3-Coder-30B-A3B-Instruct-4bit  — faster (~60-90 tok/s), lower quality, ~17GB
#   mlx-community/Qwen3-32B-4bit                     — dense 32B, 75.7% BFCL v3, ~19GB
MLX_MODEL=mlx-community/Qwen3.6-27B-OptiQ-4bit

# Maximum tokens the local model can generate per response
MLX_MAX_TOKENS=16384

# --- Generation ---
# Sampling temperature (Qwen3.6-27B best practice: 0.6)
MLX_TEMPERATURE=0.6

# Nucleus sampling threshold (Qwen3.6-27B best practice: 0.95)
MLX_TOP_P=0.95

# Top-K sampling (Qwen3.6-27B best practice: 20)
MLX_TOP_K=20

# Repetition penalty (prevents degenerate loops)
MLX_REPETITION_PENALTY=1.05

# --- Speculative Decoding (optional) ---
# Small draft model for faster generation (leave empty to disable)
# MLX_DRAFT_MODEL=mlx-community/Qwen2.5-Coder-1.5B-Instruct-4bit
# MLX_SPECULATIVE_TOKENS=5

# --- Routing ---
# Maximum estimated token count for local routing (longer contexts go to Anthropic)
# Qwen3.6-27B supports 128K native; 64K is a conservative default that
# keeps KV cache memory reasonable.
MAX_LOCAL_CONTEXT_TOKENS=65536

# Forward threshold: requests with forward_score >= this value go to Claude API.
# Lower = more forwarding, Higher = more local routing (aggressive)
# 0.7 is tuned for Qwen3.6-27B — single signals stay local, only stacked signals forward.
ROUTING_THRESHOLD=0.7

# Auto-calibrate routing threshold from feedback data
ADAPTIVE_ROUTING=true

# Log routing decisions to stdout
LOG_ROUTING=true

# --- Embedding Routing ---
# Use model embeddings to classify request difficulty (augments regex heuristics)
EMBED_ROUTING=true

# Weight applied to embedding classifier output in forward score (0.0–1.0)
EMBED_WEIGHT=0.3

# Minimum training examples before probe is used
EMBED_MIN_SAMPLES=100

# --- Multi-Model Pool (optional) ---
# Small fast model for trivial requests (git commands, simple edits)
# Leave empty to disable — all local requests go to the main model
# MLX_FAST_MODEL=mlx-community/Qwen2.5-Coder-1.5B-Instruct-4bit

# Maximum tokens for fast model responses
FAST_MODEL_MAX_TOKENS=2048

# Forward score must be below this for trivial classification
TRIVIAL_THRESHOLD=0.3

# --- Trust-But-Verify (TBV) — QA/QC Routing Verification ---
# Enable TBV system (spot-checks routing decisions via Claude validation)
VERIFY_ENABLED=false

# Fixed sample rate override (0.0 = use adaptive rate; >0 = fixed rate 0.0–1.0)
VERIFY_SAMPLE_RATE=0.0

# Shadow mode: also forward sampled local requests to Claude for comparison
VERIFY_SHADOW_MODE=false

# Model used for verification judgments
VERIFY_MODEL=claude-sonnet-4-20250514

# Maximum pending verification tasks in the queue
VERIFY_QUEUE_SIZE=50

# Allow TBV to dynamically adjust routing weights
VERIFY_AUTO_TUNE=true

# Minimum acceptable score per axis (1–5; below = fail)
VERIFY_MIN_SCORE=3

# Optional webhook URL to POST alerts when pass rate drops (empty = disabled)
# VERIFY_ALERT_WEBHOOK=https://hooks.example.com/tbv-alert

# --- Quality Assurance Gate (pre-delivery shadow validation) ---
# Enable confidence-gated routing with shadow validation
QA_GATE_ENABLED=false

# Forward score below this = confident local (bypass gate)
QA_GATE_LOWER=0.3

# Forward score above this = confident forward (skip to Claude)
QA_GATE_UPPER=0.7

# Seconds to wait for both local + Claude to finish
QA_GATE_TIMEOUT=10

# Model used for equivalence validation judgments
QA_GATE_VALIDATION_MODEL=claude-sonnet-4-20250514

# Samples needed for category to reach "Trusted" trust level
QA_TRUST_MIN_SAMPLES=50

# Samples needed for category to reach "Proven" trust level
QA_TRUST_PROVEN_SAMPLES=100

# Pass rate threshold for "Trusted" status
QA_TRUST_PASS_THRESHOLD=0.95

# Pass rate threshold for "Proven" status
QA_TRUST_PROVEN_THRESHOLD=0.98

# --- Upstream API ---
# Where to forward complex requests (default: Anthropic's API)
ANTHROPIC_API_URL=https://api.anthropic.com
