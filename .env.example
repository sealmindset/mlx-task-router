# =============================================================================
# MLX Task Router Configuration
# =============================================================================
# Copy this file to ~/.config/mlx-task-router/.env (recommended for global use)
# or to .env in the project directory (for development).
#
# Environment variables always take precedence over .env files.
# =============================================================================

# --- Required ---
# Your Anthropic API key. Used to forward complex requests to the real API.
# Get one at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# HuggingFace token for authenticated model downloads (faster, higher rate limits).
# Get one at: https://huggingface.co/settings/tokens
# HF_TOKEN=hf_...

# --- Server ---
HOST=0.0.0.0
PORT=8888

# --- Model ---
# MLX model to load at startup (any HuggingFace path from mlx-community)
#
# Qwen3.6-27B-OptiQ: Best local coding model for Apple Silicon (April 2026)
#   - Dense 27B with mixed-precision quantization (~18GB)
#   - SWE-bench Verified: 77.2% | Terminal-Bench 2.0: 59.3% (= Claude 4.5 Opus)
#   - 128K native context, Thinking Preservation across turns
#   - Runs comfortably on 32GB+ machines (M2 Pro and up)
#   - Compatible with stock mlx-lm (no mlx-vlm needed)
#
# Alternatives:
#   mlx-community/Qwen3-Coder-Next-4bit              — MoE 80B/3B active, 70.6% SWE-bench, ~48GB (128GB required)
#   mlx-community/Qwen3-Coder-30B-A3B-Instruct-4bit  — faster (~60-90 tok/s), lower quality, ~17GB
#   mlx-community/Qwen3-32B-4bit                     — dense 32B, 75.7% BFCL v3, ~19GB
MLX_MODEL=mlx-community/Qwen3.6-27B-OptiQ-4bit

# Maximum tokens the local model can generate per response
MLX_MAX_TOKENS=16384

# --- Generation ---
# Sampling temperature (Qwen3.6-27B best practice: 0.6)
MLX_TEMPERATURE=0.6

# Nucleus sampling threshold (Qwen3.6-27B best practice: 0.95)
MLX_TOP_P=0.95

# Top-K sampling (Qwen3.6-27B best practice: 20)
MLX_TOP_K=20

# Repetition penalty (prevents degenerate loops)
MLX_REPETITION_PENALTY=1.05

# --- Speculative Decoding (optional) ---
# Small draft model for faster generation (leave empty to disable)
# MLX_DRAFT_MODEL=mlx-community/Qwen2.5-Coder-1.5B-Instruct-4bit
# MLX_SPECULATIVE_TOKENS=5

# --- Routing ---
# Maximum estimated token count for local routing (longer contexts go to Anthropic)
# Qwen3.6-27B supports 128K native; 64K is a conservative default that
# keeps KV cache memory reasonable.
MAX_LOCAL_CONTEXT_TOKENS=65536

# Forward threshold: requests with forward_score >= this value go to Claude API.
# Lower = more forwarding, Higher = more local routing (aggressive)
ROUTING_THRESHOLD=0.5

# Auto-calibrate routing threshold from feedback data
ADAPTIVE_ROUTING=true

# Log routing decisions to stdout
LOG_ROUTING=true

# --- Upstream API ---
# Where to forward complex requests (default: Anthropic's API)
ANTHROPIC_API_URL=https://api.anthropic.com
